# --- LLM ---
# Get a key from https://console.anthropic.com/
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Database ---
# Default: zero-setup local SQLite (great for hackathon demo)
DATABASE_URL=sqlite:///lexiguide.db
# Production example (MySQL, see database/schema.sql):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/lexiguide

# --- App ---
SECRET_KEY=change-me-in-production
FLASK_ENV=development
MAX_UPLOAD_MB=15
CORS_ORIGIN=http://localhost:5173
